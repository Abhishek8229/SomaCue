# SomaCue environment variables.
#
# Copy this file to apps/web/.env and fill it in. Next.js, Prisma (prisma.config.ts) and the scripts
# under scripts/ all read apps/web/.env. Never commit the real file: .gitignore already excludes it.
# Every value below is a placeholder.

# --- Database ---------------------------------------------------------------------------------
# PostgreSQL 18 connection string. Used by the app and by pnpm db:deploy. In production the database runs on the
# same host and listens on 127.0.0.1 only (see docs/AWS_DEPLOYMENT_PLAN.md).
DATABASE_URL=postgresql://user:password@localhost:5432/somacue

# --- Sessions and Google sign-in --------------------------------------------------------------
# Signs session cookies and the Google sign-in state. Required in production, at least 32 characters:
# the placeholder below is too short on purpose, so a production start refuses it until you replace it.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me

# Public origin of the app. Google redirects back to
# ${NEXT_PUBLIC_APP_URL}/api/auth/google/callback, so add exactly that URL under
# "Authorized redirect URIs" in the Google Cloud OAuth client.
NEXT_PUBLIC_APP_URL=http://localhost:3100

# Google sign-in (OAuth 2.0 web client). Google is the only way to sign in or create an account,
# so both values are required. If either is empty, /login and /register show a "not set up" message.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# --- Patient file uploads ---------------------------------------------------------------------
# Files go to one private S3 bucket. In production the EC2 instance role supplies the credentials: never set
# AWS access keys. Without UPLOADS_BUCKET, development and tests write to apps/web/public/uploads; production
# refuses to start storing files without it.
UPLOADS_BUCKET=
AWS_REGION=ap-southeast-2

# --- AI provider ------------------------------------------------------------------------------
# Any OpenAI-compatible provider (for example OpenRouter). Every AI feature (triage, scan analysis,
# plan generation, report extraction and the Rehab Companion) reads these three and nothing else.
# All three are required: a request fails with an error naming the missing one. The code names no
# model. AI_MODEL is the model slug your provider expects, for example "vendor/model-name".
# Gemini: when AI_BASE_URL contains generativelanguage.googleapis.com, or AI_API_KEY starts with "AQ.", requests use
# Gemini's native v1beta API (x-goog-api-key header, generateContent / streamGenerateContent) instead of its
# OpenAI-compatible endpoint. A leading "models/" or "google/" on AI_MODEL is ignored. Other providers are unchanged.
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=your-ai-provider-api-key
AI_MODEL=vendor/model-name

# --- Razorpay billing (SomaCue Pro) -----------------------------------------------------------
# Use test keys (rzp_test_...) until live KYC is approved. Keys: Razorpay Dashboard > Account &
# Settings > API keys. The key id is public and is repeated for the browser; the secret stays server-side.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Pro is sold as one payment for 30, 60 or 90 days (₹199, ₹299, ₹349). Each is a single-cycle
# Razorpay subscription. RAZORPAY_PRO_PLAN_ID is the 1 month plan; 
ode scripts/setup-razorpay-plan.mjs
# creates it and fills it in. The 2 and 3 month plans are optional: when these are empty the app finds
# or creates them through the Razorpay API the first time someone buys them.
RAZORPAY_PRO_PLAN_ID=
RAZORPAY_PRO_PLAN_2M_ID=
RAZORPAY_PRO_PLAN_3M_ID=
# Razorpay Dashboard > Webhooks. Point it at ${NEXT_PUBLIC_APP_URL}/api/billing/webhook and enable
# subscription.authenticated, .activated, .charged, .pending, .halted, .cancelled.
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# --- Promo codes ------------------------------------------------------------------------------
# Optional. A signed-in user who enters one of these codes under Billing > Apply your promo code gets
# 60 days of SomaCue Pro with no payment. Comma-separated, case-insensitive, spaces around entries ignored.
# An optional ":N" suffix caps the total number of people who can use that code; without it the code
# has no cap. Each user can use a given code once, and a code cannot be applied while Pro is active.
# Codes are 3 to 40 characters (letters, digits, "-" and "_"). Entries that do not fit are ignored.
# Keep real codes here in apps/web/.env or your host's settings, never in a tracked file.
PROMO_CODES=EXAMPLECODE,LIMITEDCODE:25

# --- Public business details ------------------------------------------------------------------
# Shown on /terms, /privacy, /refunds and /contact. Razorpay's live KYC checks these pages, so use the
# real registered details. Anything left empty is shown as "not published yet".
NEXT_PUBLIC_BUSINESS_LEGAL_NAME=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_BUSINESS_ADDRESS=
# Local emergency number shown in the urgent-care notice, for example 112. Optional.
NEXT_PUBLIC_EMERGENCY_NUMBER=