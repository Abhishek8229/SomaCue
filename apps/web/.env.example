# Copy to apps/web/.env and fill in. Never commit the real file.

# Postgres (Neon). Used by the app and by `prisma migrate deploy`.
DATABASE_URL=

# Signs session cookies and the Google sign-in state. Required in production,
# at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Public origin of the app. Google redirects back to
# ${NEXT_PUBLIC_APP_URL}/api/auth/google/callback, so add exactly that URL
# under "Authorized redirect URIs" in the Google Cloud OAuth client.
NEXT_PUBLIC_APP_URL=http://localhost:3100

# Google sign-in (OAuth 2.0 web client). Google is the only way to sign in or create an account,
# so both values are required. If either is empty, /login and /register show a "not set up" message.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Patient file uploads. Without Azure, files are stored under public/uploads.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=

# AI provider (OpenAI-compatible, for example OpenRouter). Every AI feature (triage, scan analysis,
# plan generation, report extraction and the Rehab Companion) reads these three and nothing else.
# All three are required: a request fails with an error naming the missing one. The code names no model.
# AI_MODEL is the model slug your provider expects, for example "vendor/model-name".
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Razorpay billing (SomaCue Pro). Use test keys (rzp_test_...) until live KYC is approved.
# Keys: Razorpay Dashboard > Account & Settings > API keys. The key id is public and is
# repeated for the browser; the secret must stay server-side.
RAZORPAY_KEY_ID=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Pro is sold as one payment for 30, 60 or 90 days (₹199, ₹299, ₹349). Each is a single-cycle Razorpay
# subscription. RAZORPAY_PRO_PLAN_ID is the 1 month plan; `node scripts/setup-razorpay-plan.mjs` fills it in.
# The 2 and 3 month plans are optional: when these are empty the app finds or creates them through the
# Razorpay API (Test and Live) the first time someone buys them.
RAZORPAY_PRO_PLAN_ID=
RAZORPAY_PRO_PLAN_2M_ID=
RAZORPAY_PRO_PLAN_3M_ID=
# Razorpay Dashboard > Webhooks. Point it at ${NEXT_PUBLIC_APP_URL}/api/billing/webhook and
# enable subscription.authenticated, .activated, .charged, .pending, .halted, .cancelled.
RAZORPAY_WEBHOOK_SECRET=

# Shown on /terms, /privacy and /contact. Razorpay's live KYC checks these pages, so use the
# real registered details. Anything left empty is shown as "not published yet".
NEXT_PUBLIC_BUSINESS_LEGAL_NAME=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_BUSINESS_ADDRESS=
