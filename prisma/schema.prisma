generator client {
  provider = "prisma-client"
  output   = "../apps/web/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  /// Null for accounts created through Google sign-in.
  passwordHash String?
  /// Google account id (the "sub" claim). Set when the user signs in with Google.
  googleId     String?  @unique
  avatarUrl    String?
  name         String
  role         String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  patientAssessments   ClinicalAssessment[] @relation("PatientAssessments")
  clinicianAssessments ClinicalAssessment[] @relation("ClinicianAssessments")
  chatMessages         ChatMessage[]
  recoveryEvents       RecoveryEvent[]
  subscription         Subscription?
  proPurchases         ProPurchase[]
}

model ClinicalAssessment {
  id                 String   @id @default(cuid())
  patientId          String
  clinicianId        String?
  rawReportText      String
  extractedDiagnosis Json     @db.JsonB
  safetyStatus       String   @default("PENDING")
  createdAt          DateTime @default(now()) @db.Timestamptz(3)

  patient             User                 @relation("PatientAssessments", fields: [patientId], references: [id], onDelete: Cascade)
  clinician           User?                @relation("ClinicianAssessments", fields: [clinicianId], references: [id], onDelete: SetNull)
  prescribedMovements PrescribedMovement[]

  @@index([patientId])
  @@index([clinicianId])
  @@index([safetyStatus])
}

model ClinicalReport {
  id              String   @id @default(uuid())
  patientId       String
  weekNumber      Int      @default(1)
  primarySymptoms String
  /// Every uploaded file (scans and prescriptions). Older reports only have this.
  fileUrls        String[]
  /// MRIs, X-rays, CT scans and other diagnostic imaging.
  scanUrls         String[]  @default([])
  /// Prescriptions and notes from a doctor, physiotherapist or other clinician.
  prescriptionUrls String[]  @default([])
  /// Set when the patient acknowledged AI limits because no prescription was uploaded.
  aiDisclaimerAcceptedAt DateTime? @db.Timestamptz(3)
  /// Condition identified at triage, e.g. "L4–L5 disc bulge".
  conditionTitle   String?
  /// Plain-language 2–3 sentence description of the condition.
  conditionSummary String?
  /// What the condition was derived from: reports_and_scans, reports_and_symptoms,
  /// scans_and_symptoms, files_and_symptoms or symptoms_only.
  conditionSource  String?
  /// The triage AI judged that guided online rehab is not safe for this case.
  requiresInPersonCare Boolean @default(false)
  /// The triage AI's safety reasoning.
  careReason       String?
  /// "triage" or "progress" once the platform is locked for in-person care.
  escalationKind     String?
  escalationReason   String?
  escalationEvidence String[]  @default([])
  escalatedAt        DateTime? @db.Timestamptz(3)
  adaptiveData    Json     @db.JsonB
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  triageQuiz    TriageQuiz?
  treatmentPlan TreatmentPlan?
  dailyProgress DailyProgress[]
  painEvents    PainEvent[]
  chatMessages  ChatMessage[]
  recoveryEvents RecoveryEvent[]

  @@index([patientId])
  @@index([createdAt])
}

/// Rehab Companion chat. Each intake (report) has its own conversation, so a
/// new intake starts a clean chat. clearedAt hides messages without deleting
/// them, so clearing the chat never resets the daily message limit.
model ChatMessage {
  id               String    @id @default(uuid())
  patientId        String
  /// null for a conversation before the first intake
  clinicalReportId String?
  /// "user" or "assistant"
  role             String
  content          String
  /// Why a guard answered instead of the AI: off_topic, injection, red_flag,
  /// rate_limit. null for AI answers and normal user messages.
  guard            String?
  clearedAt        DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)

  patient        User            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  clinicalReport ClinicalReport? @relation(fields: [clinicalReportId], references: [id], onDelete: Cascade)

  @@index([patientId, createdAt])
  @@index([clinicalReportId, createdAt])
}

/// One entry of the patient's Recovery Timeline (Patient Case Record), written as things happen.
/// Existing history is also derived at read time from the reports, plans, daily logs and pain events,
/// and merged by dedupeKey, so the timeline works for accounts that predate this table.
model RecoveryEvent {
  id               String   @id @default(uuid())
  patientId        String
  clinicalReportId String?
  /// analysis, plan, week, missed_day, session, feedback, pain_override, plan_adjusted, precaution, chat_insight, escalation
  kind             String
  title            String
  detail           String?
  /// The local YYYY-MM-DD the event belongs to, for events that are about a day.
  dateKey          String?
  occurredAt       DateTime @db.Timestamptz(3)
  /// Small structured facts for the trends: { feedback, regions, painType }. Null when there are none.
  meta             Json?    @db.JsonB
  /// Stable per fact (for example "feedback:<report>:<day>"), so logging twice or deriving the same fact adds nothing.
  dedupeKey        String
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  patient        User            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  clinicalReport ClinicalReport? @relation(fields: [clinicalReportId], references: [id], onDelete: Cascade)

  @@unique([patientId, dedupeKey])
  @@index([patientId, occurredAt])
}

model PainEvent {
  id               String    @id @default(uuid())
  clinicalReportId String
  patientId        String
  dateKey          String
  exerciseNames    String[]
  painType         String
  regions          String[]
  details          String
  context          Json      @db.JsonB
  rescheduledAt    DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)

  clinicalReport ClinicalReport @relation(fields: [clinicalReportId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([clinicalReportId, dateKey])
}

model DailyProgress {
  id                  String    @id @default(uuid())
  clinicalReportId    String
  patientId           String
  dateKey             String
  completedExercises  String[]
  completedAt         DateTime? @db.Timestamptz(3)
  feedback            String?
  notes               String?
  discomfortExercises String[]
  discomfortDetails   String?
  rescheduledAt       DateTime? @db.Timestamptz(3)
  stoppedAt           DateTime? @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(3)

  clinicalReport ClinicalReport @relation(fields: [clinicalReportId], references: [id], onDelete: Cascade)

  @@unique([clinicalReportId, dateKey])
  @@index([patientId])
}

model TriageQuiz {
  id              String       @id @default(uuid())
  clinicalReportId String       @unique
  questions       Json         @db.JsonB
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)

  clinicalReport ClinicalReport @relation(fields: [clinicalReportId], references: [id], onDelete: Cascade)
  answers       QuizAnswer[]
}

model QuizAnswer {
  id          String     @id @default(uuid())
  triageQuizId String
  questionId  String
  answer      String
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)

  triageQuiz TriageQuiz @relation(fields: [triageQuizId], references: [id], onDelete: Cascade)

  @@unique([triageQuizId, questionId])
  @@index([triageQuizId])
}

model TreatmentPlan {
  id              String         @id @default(uuid())
  clinicalReportId String         @unique
  routine         Json           @db.JsonB
  /// Condition-level precautions from the analysis: a JSON array of 3 to 5 short strings. Null for plans made before this existed.
  permanentPrecautions Json?      @db.JsonB
  /// Precautions for the plan's current week and recent sessions: { items, badge, kind, updatedAt, seenAt, weekNumber, phaseIndex, base }. See lib/precautions.
  dynamicPrecautions   Json?      @db.JsonB
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)

  clinicalReport ClinicalReport @relation(fields: [clinicalReportId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model Exercise {
  id             String   @id @default(cuid())
  name           String
  movementPlanes String[]

  prescribedMovements PrescribedMovement[]

  @@index([name])
}

model PrescribedMovement {
  id           String @id @default(cuid())
  assessmentId String
  exerciseId   String

  assessment ClinicalAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  exercise   Exercise           @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@index([assessmentId])
  @@index([exerciseId])
}

/// One billing record per user. Pro access is derived from it in lib/billing/entitlements.ts.
/// Table and column names are snake_case on purpose: they are the billing contract.
model Subscription {
  id                     String    @id @default(cuid())
  userId                 String    @unique @map("user_id")
  /// Always "razorpay" today.
  provider               String    @default("razorpay")
  providerCustomerId     String?   @map("provider_customer_id")
  providerSubscriptionId String?   @unique @map("provider_subscription_id")
  /// "free" or "pro"
  plan                   String    @default("free")
  /// "created", "authenticated", "active", "pending", "halted" or "cancelled"
  status                 String    @default("created")
  currentPeriodEnd       DateTime? @map("current_period_end") @db.Timestamptz(3)
  cancelAtPeriodEnd      Boolean   @default(false) @map("cancel_at_period_end")
  /// The tier of the latest paid purchase: "1m", "2m" or "3m". Null for rows from before tiers.
  tier                   String?
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

/// One Pro checkout: a fixed 30, 60 or 90 days of access for one payment. It is created
/// "created" when checkout opens and flips to "paid" exactly once, which is what
/// makes the verify route and the webhook safe to run for the same payment.
model ProPurchase {
  id                     String    @id @default(cuid())
  userId                 String    @map("user_id")
  providerSubscriptionId String    @unique @map("provider_subscription_id")
  /// "1m", "2m" or "3m"
  tier                   String
  days                   Int
  amountMinor            Int       @map("amount_minor")
  /// "created" until the payment is confirmed, then "paid"
  status                 String    @default("created")
  providerPaymentId      String?   @map("provider_payment_id")
  paidAt                 DateTime? @map("paid_at") @db.Timestamptz(3)
  /// The access window this payment added, set when it is paid.
  accessStart            DateTime? @map("access_start") @db.Timestamptz(3)
  accessEnd              DateTime? @map("access_end") @db.Timestamptz(3)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("pro_purchases")
}

/// Razorpay webhook events already handled, so a retried delivery is applied once.
model BillingEvent {
  eventId     String   @id @map("event_id")
  eventType   String   @map("event_type")
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@map("billing_events")
}
