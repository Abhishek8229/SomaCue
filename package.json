{
  "name": "somacue",
  "version": "0.2.0",
  "private": true,
  "description": "SomaCue pnpm workspace for the Stage 4.1 3D demonstration prototype.",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "pnpm --filter @somacue/web dev",
    "build": "pnpm --filter @somacue/web build",
    "start": "pnpm --filter @somacue/web start",
    "lint": "pnpm --filter @somacue/web lint",
    "typecheck": "pnpm --filter @somacue/web typecheck",
    "verify:interactions": "node scripts/verify-interactions.cjs",
    "verify:3d-lab": "node scripts/verify-3d-lab.cjs"
  },
  "devDependencies": {
    "puppeteer-core": "^24.38.0"
  }
}
