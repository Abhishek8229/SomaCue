{
  "name": "somacue",
  "version": "0.2.0",
  "private": true,
  "description": "SomaCue pnpm workspace for the Stage 4.1 3D demonstration prototype.",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @somacue/web dev",
    "build": "pnpm --filter @somacue/web build",
    "start": "pnpm --filter @somacue/web start",
    "lint": "pnpm --filter @somacue/web lint",
    "typecheck": "pnpm --filter @somacue/web typecheck",
    "test": "pnpm --filter @somacue/web test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "verify:interactions": "node scripts/verify-interactions.cjs",
    "verify:auth": "node scripts/verify-auth.cjs",
    "verify:3d-lab": "node scripts/verify-3d-lab.cjs",
    "verify:lab-first-frame": "node scripts/verify-lab-first-frame.cjs",
    "postinstall": "prisma generate"
  },
  "devDependencies": {
    "dotenv": "17.4.2",
    "prisma": "7.10.1",
    "puppeteer-core": "^24.38.0"
  }
}
